{
    "name": "donatj/p9p2000",
    "description": "A simple 9P2000 protocol client for PHP with stream wrapper support",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "donatj\\P9p2000\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "=2.3.4",
        "phpunit/phpunit": "^10.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "donatj/mddoc": "=0.14.1",
        "corpus/php-cs-fixer-config": "=0.1.1"
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "test-docs": "mddoc --dry-run=true",
        "test-fixer": "php-cs-fixer fix --dry-run --diff"
    },
    "authors": [
        {
            "name": "Jesse Donat"
        }
    ],
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
