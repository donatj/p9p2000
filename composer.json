{
    "name": "donatj/p9p2000",
    "description": "A simple 9P2000 protocol client for PHP with stream wrapper support",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "donatj\\P9p2000\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "=2.2.6",
        "phpunit/phpunit": "^10.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Jesse Donat"
        }
    ],
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
