<mddoc>
    <autoloader type="composer"/>
    <docpage target="README.md">
        <section title="PHP Plan 9 9P2000">
            <badge-github-action name="donatj/p9p2000" workflow-file="ci.yml"/>
            <text>This is a toy implementation of Plan 9's 9P2000 as a PHP stream wrapper, allowing calls such as:</text>
            <text>&gt; `file_get_contents('9p://localhost:564/path/to/file');`</text>
            <text>It is very buggy and only works with certain 9P2000 servers.</text>
            <text><![CDATA[<img width="1004" height="565" alt="image" src="https://github.com/user-attachments/assets/fd13e288-1391-4f67-a171-e49b93e11573" />]]></text>
            <section title="Requirements"><composer-requires/></section>
            <section title="Installing"><composer-install/></section>
            <section title="Documentation">
                <file name="src/Client.php"/>
                <file name="src/StreamWrapper.php"/>
            </section>
            <section title="Full API Docs">
                <docpage target="DOCS.md">
                    <section title="Full API Docs">
                        <recursive-directory warn-undocumented="false" name="src"/>
                    </section>
                </docpage>
            </section>
        </section>
    </docpage>
</mddoc>
